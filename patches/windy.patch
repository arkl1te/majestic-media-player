diff --git a/src/windy/platforms/linux/x11.nim b/src/windy/platforms/linux/x11.nim
index 5b29e3c..4695b56 100644
--- a/src/windy/platforms/linux/x11.nim
+++ b/src/windy/platforms/linux/x11.nim
@@ -814,8 +814,11 @@ proc newWindow*(
   result.applyCursor()
 
   # Enable XDnD awareness (version 5)
-  const xdndVersion = 5'u32
-  result.handle.setProperty(xaXdndAware, xaCardinal, 32, @[xdndVersion].asString)
+  # The spec (and KWin's Wayland-to-XWayland drag bridge) requires type ATOM;
+  # Xlib reads format-32 data as C longs.
+  const xdndVersion = 5.clong
+  display.XChangeProperty(result.handle, xaXdndAware, xaAtom, 32, pmReplace,
+    @[xdndVersion].asString, 1)
 
   makeContextCurrent result
 
@@ -865,8 +868,8 @@ proc pollEvents(window: Window) =
     d: Display,
     event: ptr XEvent,
     userData: pointer
-  ): bool {.cdecl.} =
-    event.any.window == cast[Window](userData).handle
+  ): cint {.cdecl.} =
+    cint(event.any.window == cast[Window](userData).handle)
 
   template pushButtonEvent(
     button: Button,
@@ -941,6 +944,13 @@ proc pollEvents(window: Window) =
         if window.xdndVersion > 5:
           continue
 
+        # The drag source owns the pointer, so no motion events arrive; track
+        # the drag position (root x << 16 | y) so a drop can tell where it hit.
+        let rootPos = ivec2(int32(ev.client.data.l[2] shr 16 and 0xffff),
+          int32(ev.client.data.l[2] and 0xffff))
+        window.mousePrevPos = window.mousePos
+        window.mousePos = rootPos - window.pos
+
         # Send status back to source.
         let acceptFlag: clong = if window.xdndFormat != 0: 1 else: 0
         let action: clong = if window.xdndVersion >= 2 and window.xdndFormat != 0: cast[clong](xaXdndActionCopy) else: 0
@@ -1128,12 +1138,14 @@ proc pollEvents(window: Window) =
           # Parse URI list (files separated by newlines).
           let uriList = prop.data
           for line in uriList.splitLines():
-            if line.len > 0 and line.startsWith("file://"):
-              # Convert URI to local path and decode percent-encoding.
-              var filePath = decodeUrl(line[7..^1])
-              if window.onFileDrop != nil:
-                let fileContent = readFile(filePath)
-                window.onFileDrop(filePath, fileContent)
+            if line.len > 0 and not line.startsWith("#") and window.onFileDrop != nil:
+              # Convert file URIs to local paths; other URIs (http, ...) pass
+              # through. The contents are not read: drops can be huge media
+              # files or directories, so fileData is always empty.
+              let filePath =
+                if line.startsWith("file://"): decodeUrl(line[7..^1], decodePlus = false)
+                else: line
+              window.onFileDrop(filePath, "")
 
         # Clean up the property.
         window.handle.delProperty(xaWindyXdndTargetProperty)
@@ -1224,8 +1236,8 @@ proc processClipboardEvents: bool =
     d: Display,
     event: ptr XEvent,
     userData: pointer
-  ): bool {.cdecl.} =
-    event.any.window == cast[XWindow](userData)
+  ): cint {.cdecl.} =
+    cint(event.any.window == cast[XWindow](userData))
 
   while display.XCheckIfEvent(
     ev.addr, checkEvent, cast[pointer](clipboardWindow)
diff --git a/src/windy/platforms/linux/x11/xevent.nim b/src/windy/platforms/linux/x11/xevent.nim
index 1147b56..f88aa59 100644
--- a/src/windy/platforms/linux/x11/xevent.nim
