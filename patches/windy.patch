@@ -5,7 +5,7 @@ type
     d: Display,
     event: ptr XEvent,
     p: pointer
-  ): bool {.cdecl.}
+  ): cint {.cdecl.} ## Xlib's Bool (an int): a Nim bool leaves the upper bytes undefined
   ErrorHandleProc* = proc (d: Display, event: ptr XErrorEvent): bool {.cdecl.}
 
   XEventKind* {.size: cint.sizeof.} = enum
