-              var filePath = decodeUrl(line[7..^1])
-              if window.onFileDrop != nil:
-                let fileContent = readFile(filePath)
-                window.onFileDrop(filePath, fileContent)
+            if line.len > 0 and not line.startsWith("#") and window.onFileDrop != nil:
+              # Convert file URIs to local paths; other URIs (http, ...) pass
+              # through. The contents are not read: drops can be huge media
+              # files or directories, so fileData is always empty.
+              let filePath =
+                if line.startsWith("file://"): decodeUrl(line[7..^1], decodePlus = false)
+                else: line
